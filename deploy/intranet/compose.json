{
  "version": "3.7",
  "networks": {
    "internal": {}
  },
  "volumes": {
    "database": {},
    "temporal-database": {},
    "evidence": {}
  },
  "services": {
    "gateway": {
      "image": "${AE_NGINX_IMAGE:?fixed nginx digest required}",
      "restart": "unless-stopped",
      "ports": [
        "127.0.0.1:18443:443"
      ],
      "volumes": [
        "./nginx.conf:/etc/nginx/conf.d/default.conf:ro",
        "./frontend:/usr/share/nginx/html:ro",
        "./shared/tls:/etc/nginx/tls:ro",
        "./shared/htpasswd:/etc/nginx/htpasswd:ro"
      ],
      "networks": [
        "internal"
      ],
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "mem_limit": "256m"
    },
    "postgres": {
      "image": "${AE_POSTGRES_IMAGE:?fixed postgres digest required}",
      "restart": "unless-stopped",
      "env_file": [
        "./shared/postgres.env"
      ],
      "volumes": [
        "database:/var/lib/postgresql/data"
      ],
      "networks": [
        "internal"
      ],
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "mem_limit": "4g",
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "pg_isready -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\""
        ],
        "interval": "5s",
        "timeout": "3s",
        "retries": 20
      }
    },
    "temporal-db": {
      "image": "${AE_POSTGRES_IMAGE:?fixed postgres digest required}",
      "restart": "unless-stopped",
      "env_file": [
        "./shared/temporal-db.env"
      ],
      "volumes": [
        "temporal-database:/var/lib/postgresql/data"
      ],
      "networks": [
        "internal"
      ],
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "mem_limit": "2g"
    },
    "temporal": {
      "image": "${AE_TEMPORAL_IMAGE:?fixed auto-setup digest required}",
      "restart": "unless-stopped",
      "env_file": [
        "./shared/temporal.env"
      ],
      "networks": [
        "internal"
      ],
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "mem_limit": "2g"
    },
    "storage": {
      "image": "${AE_STORAGE_IMAGE:?fixed storage digest required}",
      "restart": "unless-stopped",
      "env_file": [
        "./shared/storage.env"
      ],
      "command": [
        "server",
        "/data",
        "--console-address",
        ":9001"
      ],
      "volumes": [
        "evidence:/data"
      ],
      "networks": [
        "internal"
      ],
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "mem_limit": "2g"
    },
    "api": {
      "image": "${AE_BACKEND_IMAGE:?fixed backend image required}",
      "restart": "unless-stopped",
      "env_file": [
        "./shared/backend.env"
      ],
      "volumes": [
        "./shared/secrets:/app/.secrets:ro"
      ],
      "networks": [
        "internal"
      ],
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "mem_limit": "2g",
      "cpus": 2,
      "command": [
        "uvicorn",
        "autoeval.api:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8000"
      ]
    }
  }
}